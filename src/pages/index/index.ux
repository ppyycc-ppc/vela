  search(){
    this.hide=true;
    fetch.fetch({
      url: this.rp(this.rp(this.urs,encodeURIComponent(this.input),'$'),this.searchLen,'@'),
      method: 'GET',
      responseType: 'text',
      success: res => {
        this.send('响应请求成功！');
        this.log.push(`search successed,code: ${res.code}`);

        const json = filterArticles(JSON.parse(res.data));
        this.titleSegments=extractDataFromJson(res.data);
        console.log(JSON.stringify(this.titleSegments))
        this.send("搜索完成！")
      },
      fail: (err,code) => {
        prompt.showToast({ message: `网络错误：${code} 代码 ${err}` })
        this.log.push(`fetch fail,code: ${code} ${err}`)
      }
    })
  },

  rp(sth,tag,str){
    //替换函数
    if(str=='$')return sth.replace(/\$/g, () => tag);
    else if(str=='#')return sth.replace(/\#/g, () => tag);
    else if(str=='@')return sth.replace(/\@/g, () => tag);
  },
  onInit () {
    this.search();
    this.read();
    this.get();
    this.saveAdres(1);
    this.setTime();
    this.getUpdate();
    this.saveRead();
    setInterval(() => {
      this.setTime();
    }, 2000);
  },
  clear(){global.runGC()},
