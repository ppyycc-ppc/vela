<script>
import fetch from '@system.fetch' 
import storage from '@system.storage' 
import prompt from '@system.prompt' 
import request from '@system.request' 
import router from '@system.router' 
import file from '@system.file'


const ver=1.4


/**
 * 从JSON字符串中提取数据，转换为searchList数组
 * @param {string} jsonString - 输入的JSON字符串
 * @returns {Array} searchList数组，包含title、image、docID和segments
 */
 function extractDataFromJson(jsonString) {
  try {
    // 1. 解析JSON字符串
    const data = JSON.parse(jsonString);
    
    // 2. 检查数据结构
    if (!data || !data.data || !Array.isArray(data.data.result)) {
      console.error('JSON结构不符合预期');
      return [];
    }
    
    // 3. 提取并转换数据
    const searchList = [];
    const results = data.data.result;
    
    for (let i = 0; i < results.length; i++) {
      const item = results[i];
      
      // 提取基础字段
      const title = item.title || '';
      const image = item.imgurl && item.imgurl.length > 0 ? item.imgurl[0] : '';
      const docID = item.skipID || item.docid || '';
      
      // 处理title中的Unicode转义字符
      // 将\u003c转换为<，\u003e转换为>，\u0026转换为&等
      const decodedTitle = decodeUnicodeEscapes(title);
      
      // 将解码后的title解析为分段格式（使用您之前的parseStyledText函数）
      const segments = parseStyledText(decodedTitle);
      
      // 添加到结果数组
      searchList.push({
        title: decodedTitle.replace(/<\/?em>/g, ''),      // 解码后的标题字符串
        image: image,            // 图片URL
        docID: docID,           // 文档ID
        segments: segments      // 解析后的分段数组，用于显示
      });
    }
    
    return searchList;
    
  } catch (error) {
    console.error('解析JSON时出错:', error);
    return [];
  }
}

/**
 * 解码Unicode转义字符
 * @param {string} str - 包含Unicode转义的字符串
 * @returns {string} 解码后的字符串
 */
function decodeUnicodeEscapes(str) {
  if (!str) return '';
  
  // 常见的HTML实体转义
  const escapeMap = {
    '\\u003c': '<',    // 小于号
    '\\u003e': '>',    // 大于号
    '\\u0026': '&',    // &符号
    '\\u0027': "'",    // 单引号
    '\\u0022': '"',    // 双引号
    '\\u003d': '=',    // 等于号
    '\\u005c': '\\',   // 反斜杠
    '&lt;': '<',       // 小于号(HTML实体)
    '&gt;': '>',       // 大于号(HTML实体)
    '&amp;': '&',      // &符号(HTML实体)
    '&quot;': '"',     // 双引号(HTML实体)
    '&#39;': "'",      // 单引号(HTML实体)
  };
  
  let result = str;
  
  // 替换所有Unicode转义字符
  for (const [escape, replacement] of Object.entries(escapeMap)) {
    const regex = new RegExp(escape, 'g');
    result = result.replace(regex, replacement);
  }
  
  // 处理其他Unicode字符（通用方法）
  result = result.replace(/\\u([\dA-F]{4})/gi, (match, hex) => {
    return String.fromCharCode(parseInt(hex, 16));
  });
  
  return result;
}

/**
 * 解析字符串，转换为片段数组（复用您之前的函数）
 * 输入：'<em>北京</em>润园(售楼处)官方网站'
 * 输出：[ {text: '北京', isEm: true}, {text: '润园(售楼处)官方网站', isEm: false} ]
 */
function parseStyledText(str) {
  const segments = [];
  // 正则表达式匹配 <em>标签内容 或 非标签纯文本
  const regex = /<em>([^<]*)<\/em>|([^<]+)/g;
  let match;
  while ((match = regex.exec(str)) !== null) {
    if (match[1] !== undefined) {
      // 匹配到 <em> 标签内的内容
      segments.push({ text: match[1], isEm: true });
    } else if (match[2] !== undefined) {
      // 匹配到标签外的纯文本
      segments.push({ text: match[2], isEm: false });
    }
  }
  return segments;
}


function rand(minNum,maxNum){ 
  switch(arguments.length){ 
      case 1: 
          return parseInt(Math.random()*minNum+1,10); 
      break; 
      case 2: 
          return parseInt(Math.random()*(maxNum-minNum+1)+minNum,10); 
      break; 
          default: 
              return 0; 
          break; 
  } 
}

// const tpl    = 'https://api.example.com/cat/$/page/$?ts=$';
// const ranges = [
//   { min: 0,  max: 10 },   // 第 1 个 $
//   { min: 1,  max: 50 },   // 第 2 个 $
//   { min: 1000, max: 9999 } // 第 3 个 $
// ];

function randomizeUrl(template, ranges) {
  let i = 0;                                     // 当前占位符序号
  return template.replace(/\$/g, () => {
    if (i >= ranges.length) {
      throw new Error(`占位符数量 (${i + 1}) 超过 ranges 数组长度 (${ranges.length})`);
    }
    const { min, max } = ranges[i++];
    // 生成 [min, max] 闭区间内的随机整数
    return Math.floor(Math.random() * (max - min + 1)) + min;
  });
}

//过滤返回结果
function filterArticles(raw) {
  if (raw.code !== 0 || !Array.isArray(raw.data?.result)) return [];

  return raw.data.result.filter(item => {
    // ① 服务端明确标记的文章
    if (item.skipType === 'doc') return true;

    // ② 兜底：有些文章没写 skipType，但它们的 docid 规则固定为 “16 位字母数字”
    //      同时排除任何 _video_ 标记
    return (
      /^[A-Z0-9]{16}$/.test(item.docid) && !item.docid.includes('_video_')
    );
  });
}

function ptot(html) {
  return (html.match(/<p[^>]*>[\s\S]*?<\/p>/gi) || [])
    .map(seg => seg.replace(/<[^>]+>/g, '').trim())  // 去标签
    .filter(Boolean)
    .join('\n\n');
}

// —— demo ——
// console.log(extractPTextRegex(html));
function cut(arr, len) {
  if (len <= 0 || !Number.isInteger(len)) {
    throw new Error('len 必须是正整数');
  }

  const result = [];
  for (let i = 0; i < arr.length; i += len) {
    // slice 取出一段
    const chunk = arr.slice(i, i + len);
    // 不足 len 个时用 null 递补
    while (chunk.length < len) {
      chunk.push(null);
    }
    result.push(chunk);
  }
  return result;

}

/**
 * 获取当前时间，格式化为 "HH:MM"（24小时制，两位数）
 * @returns {string} 格式化的时间字符串，例如 "14:05" 或 "01:02"
 */
function getFormattedTime() {
  // 1. 获取当前系统时间
  const now = new Date();
  
  // 2. 获取小时和分钟
  let hours = now.getHours(); // 0-23
  let minutes = now.getMinutes(); // 0-59
  
  // 3. 格式化为两位数：使用 String.padStart 方法
  const formattedHours = String(hours).padStart(2, '0');
  const formattedMinutes = String(minutes).padStart(2, '0');
  
  // 4. 拼接并返回结果
  return `${formattedHours}:${formattedMinutes}`;
}

function formatTimestamp(timestamp) {
  // 1. 创建Date对象（注意：JavaScript时间戳通常以毫秒为单位）
  const date = new Date(timestamp); // 如果传入的是秒级时间戳，需要乘以1000
  
  // 2. 获取年、月、日、时、分、秒（月份要+1，因为getMonth()返回0-11）
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0'); // 补零
  const day = String(date.getDate()).padStart(2, '0');
  const hours = String(date.getHours()).padStart(2, '0');
  const minutes = String(date.getMinutes()).padStart(2, '0');
  const seconds = String(date.getSeconds()).padStart(2, '0');
  
  // 3. 拼接成常见的格式，例如 "YYYY-MM-DD HH:MM:SS"
  return `${year}-${month}-${day} ${hours}:${minutes}`;
}

