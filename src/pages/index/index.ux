  // 更新信息
  getUpdate(){
    fetch.fetch({
      url: this.ura,
      method: 'GET',
      responseType: 'text',
      success: res => {
        this.log.push(`fetch successed,code: ${res.code}`);

        const json = JSON.parse(res.data);
        this.send(`最近更新版本：${json.dev}\n\n${JSON.parse(json.ver)>ver?'现有可进行的更新！':'已是最新版本！'}`,3000)
      },
    })
  },


  /** 抓取首页推荐列表 */
  get () {
    this.log.push(`start getting ${this.url}`)
    


    fetch.fetch({
      url: this.rp(this.rp(this.rp(this.url,this.len,'#'),encodeURIComponent(this.city_prov[this.chosenProv].city_name),'$'),encodeURIComponent(this.city_prov[this.chosenProv].cities[this.chosenCity]),'@'),
      method: 'GET',
      responseType: 'text',
      success: res => {
        this.log.push(`fetch successed,code: ${res.code}`);

        const json = JSON.parse(res.data);
        this.wangyi=json;
        this.showList=cut(json.data,this.cutlen)
        // const cards = (json.data.cards || []).filter(c => c.mblog)
        // this.posts = [...this.posts, ...cards.map(c => c.mblog)]
        // this.sinceId = json.data.cardlistInfo.since_id
