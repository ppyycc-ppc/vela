        </div>

        <text style="border-radius:36px;border: 20px rgb(26, 26, 26);background-color:rgb(26, 26, 26);position: fixed;left:0px;width:316px;font-size:28px;font-weight:700;line-height:39.2px;color:rgba(255,255,255,0.6);">{{showData.slice(0,500)}}{{showData.length>=500?"······\n字数过长已截取":""}}</text>
