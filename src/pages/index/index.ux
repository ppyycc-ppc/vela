      },
      fail: (err,code) => {
        prompt.showToast({ message: `网络错误：${code} 代码 ${err}` })
        this.log.push(`fetch fail,code: ${code} ${err}`)
      }
    })
    // 根据需要可继续调用 URL2
  },



  getDoc(){ 
    this.send('开始请求……');
    if(this.nowDoc.length!=16){
      this.send(`此非文章！！`);
      this.pages=[1,0];
      return;
    }

    //nowDoc:文章编号
    const API=this.rp(this.urc,this.nowDoc,'$');

    fetch.fetch({
      url:API,
      method: 'GET',
      responseType: 'text',
      success: res => {
        const now=ptot(String(res.data));
        // console.log(now)
        // console.log(ptot(now));
        if(now){
          this.showData=String(now);
          
        }
        else{
          this.send(`错误，对于html,此文本不可为“read”`)
        }

        this.log.push("get html and replace successed");
      },
      fail: (err,code) => {
        this.send(`网络错误！代码${code},${err}`);
      }
    })
  },

  
  inLen(){
    for(let i=0;i<rawTitles.length;i++){
      let nweL=this.parseStyledText(rawTitles[i]);
      this.titleSegments.push(nweL);
    }
  },
  /**
   * 解析字符串，转换为片段数组。
   * 输入：'<em>北京</em>润园(售楼处)官方网站'
   * 输出：[ {text: '北京', isEm: true}, {text: '润园(售楼处)官方网站', isEm: false} ]
   */
  parseStyledText(str) {
    const segments = [];
    // 正则表达式匹配 <em>标签内容 或 非标签纯文本
    const regex = /<em>([^<]*)<\/em>|([^<]+)/g;
    let match;
    while ((match = regex.exec(str)) !== null) {
        if (match[1] !== undefined) {
            // 匹配到 <em> 标签内的内容
            segments.push({ text: match[1], isEm: true });
        } else if (match[2] !== undefined) {
            // 匹配到标签外的普通文本
            segments.push({ text: match[2], isEm: false });
        }
    }
    return segments;
  },



  //2026-1-18 更新内容
  saveSet(){
    let set={len:this.len,cut:this.cutlen,sea:this.searchLen};
    storage.set({
      key: 'setting',
      value: JSON.stringify(set),
      success: (data) => {
        this.send('保存成功~',500);
      },
      fail: (data, code)=> {
        prompt.showToast({message:'失败，请联系开发者',duration:2000});
      }
    }) 
  },

  saveRead(){
    storage.get({
      key: 'setting',
      default:JSON.stringify({len:10,cut:4,sea:10}),
      success: (data) => {
        console.log(data);
        let set=JSON.parse(data);
        this.len=set.len;
        this.cutlen=set.cut;
        this.searchLen=set.sea;
        this.log.push('"set" handling success')
      },
      fail: function(data, code) {
        console.log(`handling fail, code = ${code}`)
      }
    })
  }
}
</script>

