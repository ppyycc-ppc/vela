          <text style="position: absolute;font-size: 32px;font-weight: bold;color: rgba(255, 255, 255, 1);text-align: left;left: 119px;top: 16px;width: 186px;height: 84px;">{{wangyi.data[nowID].title}}</text>
        </div>
